# ---------------------------------------------------------------- fournisseur LLM
# azure  : API hébergée type Azure AI Inference (chat/completions), comme au brief Nauda Palisse
# ollama : petit modèle open source en local, gratuit en salle (ollama pull llama3.2:3b)
LLM_PROVIDER=azure
LLM_MODEL=Kimi-K2.5                 # ex. Kimi-K2.6 côté Azure, llama3.2:3b / qwen2.5:3b côté Ollama

# Azure AI Inference (si LLM_PROVIDER=azure)
AZURE_AI_INFERENCE_ENDPOINT=                  # ex. https://<ressource>.services.ai.azure.com/models
AZURE_AI_INFERENCE_API_KEY=

# Ollama (si LLM_PROVIDER=ollama) — vu depuis le proxy
OLLAMA_URL=http://localhost:11434   # en docker compose : http://host.docker.internal:11434

# ---------------------------------------------------------------- proxy de dérive
LLM_PROXY_URL=http://localhost:8080 # l'app parle TOUJOURS au proxy, jamais au fournisseur
LLM_PROXY_PORT=8080
DRIFT=off                           # off | latence | erreurs | score  (modifiable à chaud : POST /_drift)
LLM_TIMEOUT_S=60
LLM_RETRY_429_MAX=3                  # réessais sur quota dépassé (429) ; les 5xx ne sont jamais réessayés
LLM_RETRY_429_ATTENTE_MAX_S=30      # plafond d'attente par réessai (Retry-After ou 2, 4, 8 s)

# ---------------------------------------------------------------- déploiement
CANARY_PERCENT=10                   # part du trafic envoyée au canary par défaut (ops/deploy.py)

# ---------------------------------------------------------------- CI uniquement
MOCK=off                            # on = réponses enregistrées (eval/fixtures), aucun appel LLM. Réservé à la CI.

# ---------------------------------------------------------------- observabilité
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=mardik
OTEL_TRACES=console                 # console | off
